# Production
ENVIRONMENT=prod
LOG_LEVEL=WARNING
SECRET_KEY=prod-secret-key

# Database
DATABASE_URL=postgresql://prod_user:prod_password@prod-db.internal:5432/osdash_prod
REDIS_URL=redis://prod-redis.internal:6379/0

# Celery
CELERY_BROKER_URL=redis://prod-redis.internal:6379/0
CELERY_RESULT_BACKEND=redis://prod-redis.internal:6379/0

# OpenAI API
OPENAI_API_KEY=prod-openai-key
ASSISTANT_HUB_GPT5_PROMPT_SCAFFOLD=1
ASSISTANT_HUB_AGENTIC_EAGERNESS=medium

# Anthropic API (optional)
ANTHROPIC_API_KEY=

# Google APIs
GOOGLE_CLIENT_SECRET_PATH=/etc/osdash/credentials/prod_client_secret.json
GOOGLE_APPLICATION_CREDENTIALS=/etc/osdash/credentials/prod_service_account.json

# Microsoft Graph API
MS_GRAPH_CLIENT_ID=prod-client-id
MS_GRAPH_TENANT_ID=common
MS_GRAPH_CLIENT_SECRET=prod-client-secret

# Git Integration
GIT_USERNAME=prod-bot
GIT_EMAIL=prod-bot@example.com

# Security Settings
ENCRYPTION_KEY=prod-encryption-key
JWT_SECRET_KEY=prod-jwt-secret

# Optional: External Services
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Optional: Monitoring
SENTRY_DSN=
PROMETHEUS_PORT=9201

# GUI Settings (if running GUI)
DISPLAY=:0
