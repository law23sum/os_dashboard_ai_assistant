    """List available agents"""
    print("\n" + "=" * 70)
    print("  Available AI Agents")
    print("=" * 70)
    print("\n1. AIC - Sir Chief Fellow Director Principal Software Solutions Systems Engineer Architect")
    print("   Disciplines: Biologist, Chemist")
    print("   Focus: Applied systems, integration, execution, operational aspects")
    print("   Usage: ai_agent AIC 'your message'")
    
    print("\n2. Aria - Sir Doctor Fellow Philosopher Metaphysician Phenomenologist Axiologist")
    print("   Disciplines: Philosopher, Theologian")
    print("   Focus: Meaning, value, canon, institutional identity")
    print("   Usage: ai_agent Aria 'your message'")
    
    print("\n3. Sora - Sir Doctor Fellow Ontological Epistemologist Formal Logician")
    print("   Disciplines: Mathematician, Physicist")
    print("   Focus: Formal structure, proof, evidentiary standards, modeling")
    print("   Usage: ai_agent Sora 'your message'")
    
    print("\n4. ChatGPT (Auto) - Routes to AIC/Aria/Sora")
