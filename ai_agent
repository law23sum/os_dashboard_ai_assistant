#!/usr/bin/env python3
"""
Unified AI Agent Script

This script provides a unified interface to call AI agents:
- AIC (Chief - Execution/Operational)
- Aria (Doctor - Meaning/Values)
- Sora (Doctor - Proof/Structure)
- ChatGPT (Auto-route to AIC/Sora/Aria)
- Cursor (IDE AI Assistant)

Usage:
    ai_agent                    # Interactive mode - select agent
    ai_agent AIC "your message" # Call AIC directly
    ai_agent Aria "your message" # Call Aria directly
    ai_agent Sora "your message" # Call Sora directly
    ai_agent ChatGPT "your message" # Auto-route to AIC/Aria/Sora
    ai_agent cursor "your message" # Call Cursor AI
    ai_agent --list             # List available agents
    ai_agent --help             # Show help
"""

import os
import sys
import argparse
from pathlib import Path

# Add project root to path
project_root = Path(__file__).parent
sys.path.insert(0, str(project_root))

# Import agent system
try:
    from agents_ai import (
        setup_agents,
        Agent,
        route_prompt_to_agent,
        INTERACTION_STYLES,
        normalize_interaction_style,
    )
    AGENTS_AVAILABLE = True
except ImportError as e:
    print(f"WARN: Error importing agents_ai: {e}")
    AGENTS_AVAILABLE = False
except SyntaxError as e:
    print(f"WARN: Syntax error in agents_ai.py: {e}")
    AGENTS_AVAILABLE = False
except Exception as e:
    print(f"WARN: Error loading agents: {e}")
    AGENTS_AVAILABLE = False

# Cursor AI integration
def call_cursor_ai(message: str) -> str:
    """Call Cursor AI assistant"""
    try:
        # Try to use cursor_ai.py if available
        cursor_script = project_root / "cursor_ai.py"
        if cursor_script.exists():
            import subprocess
            result = subprocess.run(
                [sys.executable, str(cursor_script), "--provider", "cursor", "--message", message],
                capture_output=True,
                text=True,
                timeout=60
            )
            return result.stdout if result.returncode == 0 else f"Error: {result.stderr}"
        else:
            return "WARN: Cursor AI integration not available. Install cursor_ai.py"
    except Exception as e:
        return f"ERROR: Error calling Cursor AI: {e}"


