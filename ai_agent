def select_interaction_style(current=None):
    """Prompt for an interaction style selection."""
    if not INTERACTION_STYLES:
        return None
    print("\nInteraction styles:")
    for key, desc in INTERACTION_STYLES.items():
        marker = "*" if current == key else " "
        print(f"  {marker} {key:11s} - {desc}")
    choice = input("\nSelect style (blank to clear): ").strip()
    if not choice:
        return None
    normalized = normalize_interaction_style(choice)
    if not normalized:
        valid = ", ".join(sorted(INTERACTION_STYLES.keys()))
        print(f"Invalid style. Choose one of: {valid}")
        return current
    return normalized


def interactive_mode(interaction_style=None):
    """Interactive agent selection mode"""
    if not AGENTS_AVAILABLE:
        print("ERROR: Agents not available. Please check agents_ai.py")
        return
    
    agents = setup_agents()
    current_style = normalize_interaction_style(interaction_style)
    
    print("\n" + "=" * 70)
    print("  AI Agent Interactive Mode")
    print("=" * 70)
    print("\nAvailable agents:")
    for i, (name, agent) in enumerate(agents.items(), 1):
        print(f"  {i}. {name} - {agent.title.split()[0:3]}...")
    print("  4. ChatGPT (Auto) - Routes by role")
    print("  5. Cursor - IDE AI Assistant")
    print("  6. Exit")
    
    while True:
        try:
            choice = input("\nSelect agent (1-6) or agent name: ").strip()
            
            if choice.lower() in ["6", "exit", "quit"]:
                print("Exiting...")
                break
            
            # Parse choice
            agent = None
            if choice == "1" or choice.lower() == "aic":
                agent = agents.get("AIC")
                agent_name = "AIC"
            elif choice == "2" or choice.lower() == "aria":
                agent = agents.get("Aria")
                agent_name = "Aria"
            elif choice == "3" or choice.lower() == "sora":
                agent = agents.get("Sora")
                agent_name = "Sora"
            elif choice == "4" or choice.lower() in ["chatgpt", "auto"]:
                agent_name = "ChatGPT"
                agent = None
            elif choice == "5" or choice.lower() == "cursor":
                agent_name = "Cursor"
                agent = None  # Special handling for Cursor
            else:
                # Try to find by name
                for name, a in agents.items():
                    if name.lower() == choice.lower():
                        agent = a
                        agent_name = name
                        break
                
                if not agent:
                    print("ERROR: Invalid choice. Please select 1-6 or agent name.")
                    continue
            
            # Get message
            message = input(f"\n[{agent_name}] Enter your message (or 'back' to return): ").strip()
            if message.lower() in ["back", "exit", "quit"]:
                continue
            if message.lower().startswith("/style"):
                current_style = select_interaction_style(current_style)
                if current_style:
                    print(f"✓ Interaction style set to {current_style}")
                else:
                    print("✓ Interaction style cleared")
                continue
            
            if not message:
                continue
            
            # Call agent
            if agent_name == "ChatGPT":
                print(f"\n[{agent_name}] Routing...")
                routed = route_prompt_to_agent(message, agents)
                for routed_name in routed:
                    routed_agent = agents.get(routed_name)
                    if not routed_agent:
                        continue
                    print(f"\n[{routed_name}] Thinking...")
                    response = routed_agent.chat(message, interaction_style=current_style)
                    print(f"\n[{routed_name}]: {response}\n")
            elif agent_name == "Cursor":
                print(f"\n[{agent_name}] Processing...")
                response = call_cursor_ai(message)
                print(f"\n[{agent_name}]: {response}\n")
            else:
                print(f"\n[{agent_name}] Thinking...")
                response = agent.chat(message, interaction_style=current_style)
                print(f"\n[{agent_name}]: {response}\n")
                
        except KeyboardInterrupt:
            print("\n\nExiting...")
            break
        except Exception as e:
            print(f"ERROR: {e}")


def main():
    parser = argparse.ArgumentParser(
        description="Unified AI Agent Interface",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  ai_agent                           # Interactive mode
  ai_agent AIC "optimize this code"  # Call AIC
  ai_agent Aria "what is the meaning?" # Call Aria
  ai_agent Sora "prove this theorem"  # Call Sora
  ai_agent ChatGPT "route this query" # Auto-route to AIC/Aria/Sora
  ai_agent cursor "refactor this"    # Call Cursor
  ai_agent --list                     # List agents
        """
    )
    
    parser.add_argument(
        "agent",
        nargs="?",
        choices=["AIC", "Aria", "Sora", "aic", "aria", "sora", "cursor", "Cursor", "ChatGPT", "chatgpt", "Auto", "auto"],
        help="Agent to call (AIC, Aria, Sora, ChatGPT/Auto, or cursor)"
    )
    
    parser.add_argument(
        "message",
        nargs="?",
        help="Message to send to the agent"
    )
    
    parser.add_argument(
        "--list",
        action="store_true",
        help="List available agents"
    )
    
    parser.add_argument(
        "--interactive",
        "-i",
        action="store_true",
        help="Start in interactive mode"
    )
    
    parser.add_argument(
        "--style",
        "--interaction",
        dest="interaction_style",
        help="Interaction style (discussion, debate, informative, persuasive)",
    )
    
    args = parser.parse_args()
    
    # List agents
    if args.list:
        list_agents()
        return
    
    # Interactive mode (default if no args)
    if not args.agent or args.interactive:
        interactive_mode(args.interaction_style)
        return
    
    # Direct agent call
    if not args.message:
        print("ERROR: Message required when calling agent directly")
        print("Usage: ai_agent <agent> '<message>'")
        print("Or use: ai_agent (interactive mode)")
        sys.exit(1)
    
    agent_arg = args.agent.lower()
    if agent_arg in ["cursor"]:
        agent_name = "Cursor"
    elif agent_arg in ["chatgpt", "auto"]:
        agent_name = "ChatGPT"
    else:
        agent_name = args.agent
    
    if agent_name == "Cursor":
        print(f"[{agent_name}] Processing...")
        response = call_cursor_ai(args.message)
        print(f"\n[{agent_name}]: {response}\n")
    elif agent_name == "ChatGPT":
        if not AGENTS_AVAILABLE:
            print("ERROR: Agents not available. Please check agents_ai.py")
            sys.exit(1)

        agents = setup_agents()
        routed = route_prompt_to_agent(args.message, agents)
        if not routed:
            print("ERROR: No agents routed for this prompt.")
            sys.exit(1)
        for routed_name in routed:
            agent = agents.get(routed_name)
            if not agent:
                continue
            print(f"[{routed_name}] Thinking...")
            response = agent.chat(args.message, interaction_style=args.interaction_style)
            print(f"\n[{routed_name}]: {response}\n")
    else:
        if not AGENTS_AVAILABLE:
            print("ERROR: Agents not available. Please check agents_ai.py")
            sys.exit(1)
        
        agents = setup_agents()
        agent = agents.get(agent_name)
        
        if not agent:
            print(f"ERROR: Agent '{agent_name}' not found")
            sys.exit(1)
        
        print(f"[{agent_name}] Thinking...")
        response = agent.chat(args.message, interaction_style=args.interaction_style)
        print(f"\n[{agent_name}]: {response}\n")


if __name__ == "__main__":
    main()
