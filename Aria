#!/usr/bin/env python3
"""
Direct Aria Agent Call

Usage:
    Aria "your message"
    Aria                    # Interactive mode
"""

import sys
from pathlib import Path

# Add project root to path
project_root = Path(__file__).parent
sys.path.insert(0, str(project_root))

# Override sys.argv to pass Aria as agent
original_argv = sys.argv.copy()
if len(sys.argv) > 1:
    sys.argv = ["ai_agent", "Aria"] + sys.argv[1:]
else:
    sys.argv = ["ai_agent", "Aria", "--interactive"]

from ai_agent import main

if __name__ == "__main__":
    main()

