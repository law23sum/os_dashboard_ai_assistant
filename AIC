#!/usr/bin/env python3
"""
Direct AIC Agent Call

Usage:
    AIC "your message"
    AIC                    # Interactive mode
"""

import sys
from pathlib import Path

# Add project root to path
project_root = Path(__file__).parent
sys.path.insert(0, str(project_root))

# Override sys.argv to pass AIC as agent
original_argv = sys.argv.copy()
if len(sys.argv) > 1:
    sys.argv = ["ai_agent", "AIC"] + sys.argv[1:]
else:
    sys.argv = ["ai_agent", "AIC", "--interactive"]

from ai_agent import main

if __name__ == "__main__":
    main()

