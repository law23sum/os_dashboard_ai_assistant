#!/usr/bin/env python3
"""
Direct ChatGPT (Auto-Routing) Call

Usage:
    ChatGPT "your message"
    ChatGPT                    # Interactive auto-routing mode
"""

import sys
from pathlib import Path

# Add project root to path
project_root = Path(__file__).parent
sys.path.insert(0, str(project_root))

# Override sys.argv to pass ChatGPT as agent
if len(sys.argv) > 1:
    sys.argv = ["ai_agent", "ChatGPT"] + sys.argv[1:]
else:
    sys.argv = ["ai_agent", "ChatGPT", "--interactive"]

from ai_agent import main

if __name__ == "__main__":
    main()
