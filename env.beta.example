# Beta / integration hardening
ENVIRONMENT=beta
LOG_LEVEL=INFO
SECRET_KEY=beta-secret-key

# Database
DATABASE_URL=postgresql://beta_user:beta_password@beta-db.internal:5432/osdash_beta
REDIS_URL=redis://beta-redis.internal:6379/0

# Celery
CELERY_BROKER_URL=redis://beta-redis.internal:6379/0
CELERY_RESULT_BACKEND=redis://beta-redis.internal:6379/0

# OpenAI API
OPENAI_API_KEY=beta-openai-key
ASSISTANT_HUB_GPT5_PROMPT_SCAFFOLD=1
ASSISTANT_HUB_AGENTIC_EAGERNESS=medium

# Anthropic API (optional)
ANTHROPIC_API_KEY=

# Google APIs
GOOGLE_CLIENT_SECRET_PATH=/etc/osdash/credentials/beta_client_secret.json
GOOGLE_APPLICATION_CREDENTIALS=/etc/osdash/credentials/beta_service_account.json

# Microsoft Graph API
MS_GRAPH_CLIENT_ID=beta-client-id
MS_GRAPH_TENANT_ID=common
MS_GRAPH_CLIENT_SECRET=beta-client-secret

# Git Integration
GIT_USERNAME=beta-bot
GIT_EMAIL=beta-bot@example.com

# Security Settings
ENCRYPTION_KEY=beta-encryption-key
JWT_SECRET_KEY=beta-jwt-secret

# Optional: External Services
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Optional: Monitoring
SENTRY_DSN=
PROMETHEUS_PORT=9101

# GUI Settings (if running GUI)
DISPLAY=:0
