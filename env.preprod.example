# Legacy pre-production / dress rehearsal (prefer staging)
ENVIRONMENT=pre-prod
LOG_LEVEL=INFO
SECRET_KEY=preprod-secret-key

# Database
DATABASE_URL=postgresql://preprod_user:preprod_password@preprod-db.internal:5432/osdash_preprod
REDIS_URL=redis://preprod-redis.internal:6379/0

# Celery
CELERY_BROKER_URL=redis://preprod-redis.internal:6379/0
CELERY_RESULT_BACKEND=redis://preprod-redis.internal:6379/0

# OpenAI API
OPENAI_API_KEY=preprod-openai-key
ASSISTANT_HUB_GPT5_PROMPT_SCAFFOLD=1
ASSISTANT_HUB_AGENTIC_EAGERNESS=medium

# Anthropic API (optional)
ANTHROPIC_API_KEY=

# Google APIs
GOOGLE_CLIENT_SECRET_PATH=/etc/osdash/credentials/preprod_client_secret.json
GOOGLE_APPLICATION_CREDENTIALS=/etc/osdash/credentials/preprod_service_account.json

# Microsoft Graph API
MS_GRAPH_CLIENT_ID=preprod-client-id
MS_GRAPH_TENANT_ID=common
MS_GRAPH_CLIENT_SECRET=preprod-client-secret

# Git Integration
GIT_USERNAME=preprod-bot
GIT_EMAIL=preprod-bot@example.com

# Security Settings
ENCRYPTION_KEY=preprod-encryption-key
JWT_SECRET_KEY=preprod-jwt-secret

# Audit Log Settings (canonical log + segment sealing)
AUDIT_STORAGE_PATH=audit_data
AUDIT_SEGMENT_WINDOW_MINUTES=5
AUDIT_SEGMENT_TIME_FORMAT=%Y%m%d%H%M
AUDIT_SEGMENT_MAX_EVENTS=5000
AUDIT_RETENTION_HOT_DAYS=30
AUDIT_RETENTION_ARCHIVE_DAYS=395
AUDIT_RETENTION_BACKUP_YEARS=7
AUDIT_RETENTION_CLOUD_YEARS=7
# Optional: HMAC signing key for segment manifests
AUDIT_SIGNING_KEY=
# Optional: storage tier paths (local paths or mounted volumes)
AUDIT_TIER_REMOTE_ARCHIVE=
AUDIT_TIER_HARDWARE_BACKUP=
AUDIT_TIER_CLOUD_BACKUP=
# Optional: audit maintenance scheduling
AUDIT_MAINTENANCE_ENABLED=true
AUDIT_RETENTION_APPLY=false
AUDIT_RETENTION_INTERVAL_HOURS=24
AUDIT_COMPACTION_INTERVAL_HOURS=24
AUDIT_PARQUET_EXPORT_ENABLED=false
AUDIT_PARQUET_EXPORT_INTERVAL_HOURS=168
AUDIT_PARQUET_EXPORT_RANGE_DAYS=1
AUDIT_MAINTENANCE_TENANT_ID=

# Optional: External Services
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Optional: Monitoring
SENTRY_DSN=
PROMETHEUS_PORT=9200

# GUI Settings (if running GUI)
DISPLAY=:0
