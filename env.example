# Application Configuration
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-here

# Database Configuration (Heroku Postgres)
DATABASE_URL=postgresql://username:password@hostname:5432/database

# Redis Configuration (Heroku Redis)
REDIS_URL=redis://username:password@hostname:port/database

# Celery Configuration
CELERY_BROKER_URL=redis://username:password@hostname:port/database
CELERY_RESULT_BACKEND=redis://username:password@hostname:port/database

# Google APIs
GOOGLE_CLIENT_SECRET_PATH=/app/config/credentials/client_secret.json
GOOGLE_APPLICATION_CREDENTIALS=/app/config/credentials/service_account.json

# Microsoft Graph API
MS_GRAPH_CLIENT_ID=your-client-id
MS_GRAPH_TENANT_ID=your-tenant-id
MS_GRAPH_CLIENT_SECRET=your-client-secret

# Git Integration
GIT_USERNAME=your-git-username
GIT_EMAIL=your-git-email

# Security Settings
ENCRYPTION_KEY=your-encryption-key
JWT_SECRET_KEY=your-jwt-secret

# Audit Log Settings (canonical log + segment sealing)
AUDIT_STORAGE_PATH=audit_data
AUDIT_SEGMENT_WINDOW_MINUTES=5
AUDIT_SEGMENT_TIME_FORMAT=%Y%m%d%H%M
AUDIT_SEGMENT_MAX_EVENTS=5000
AUDIT_RETENTION_HOT_DAYS=30
AUDIT_RETENTION_ARCHIVE_DAYS=395
AUDIT_RETENTION_BACKUP_YEARS=7
AUDIT_RETENTION_CLOUD_YEARS=7
# Optional: HMAC signing key for segment manifests
AUDIT_SIGNING_KEY=
# Optional: storage tier paths (local paths or mounted volumes)
AUDIT_TIER_REMOTE_ARCHIVE=
AUDIT_TIER_HARDWARE_BACKUP=
AUDIT_TIER_CLOUD_BACKUP=
# Optional: audit maintenance scheduling
AUDIT_MAINTENANCE_ENABLED=true
AUDIT_RETENTION_APPLY=false
AUDIT_RETENTION_INTERVAL_HOURS=24
AUDIT_COMPACTION_INTERVAL_HOURS=24
AUDIT_PARQUET_EXPORT_ENABLED=false
AUDIT_PARQUET_EXPORT_INTERVAL_HOURS=168
AUDIT_PARQUET_EXPORT_RANGE_DAYS=1
AUDIT_MAINTENANCE_TENANT_ID=

# Immutable Audit Ledger + Archive Engine
AUDIT_BASE_DIR=
AUDIT_KEY_DIR=
AUDIT_LEDGER_DB_PATH=
AUDIT_ARCHIVE_DIR=
AUDIT_ARTIFACT_DIR=
AUDIT_ARCHIVE_ROTATION_MODE=daily
AUDIT_ARCHIVE_ROTATION_MAX_EVENTS=10000
AUDIT_ARCHIVE_RETENTION_DAYS=365
AUDIT_HMAC_KEY_PATH=
AUDIT_ENCRYPTION_KEY_PATH=
AUDIT_MAX_EVENT_BYTES=262144
AUDIT_ARCHIVE_COMPRESSION=none
# Allow non-local audit ingestion (disabled by default)
AUDIT_ALLOW_REMOTE=false

# Optional: External Services
SLACK_WEBHOOK_URL=your-slack-webhook
DISCORD_WEBHOOK_URL=your-discord-webhook

# Optional: Monitoring
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_PORT=9090

# GUI Settings (if running GUI)
DISPLAY=:0

# Agent Routing (AIC/Sora/Aria)
ASSISTANT_HUB_ROUTING_MODE=llm
AGENTS_MAX_RESPONDERS=3

# Optional per-agent model/temperature overrides
AIC_MODEL=gpt-5.2-pro
ARIA_MODEL=gpt-5.1-codex-max
SORA_MODEL=gpt-5.2
AIC_TEMPERATURE=0.5
ARIA_TEMPERATURE=0.8
SORA_TEMPERATURE=0.3
