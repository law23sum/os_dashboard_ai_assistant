# OS Dashboard AI Assistant Configuration Template
# Copy this file to .env and fill in your API credentials

# OpenAI/ChatGPT Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORGANIZATION=your_openai_organization_id_here
OPENAI_MODEL=gpt-4

# Microsoft Graph API Configuration (Office 365)
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_TENANT_ID=your_microsoft_tenant_id_here
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/callback

# Google APIs Configuration (Gmail, Calendar)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username_here

# Adobe Configuration
ADOBE_CLIENT_ID=your_adobe_client_id_here
ADOBE_CLIENT_SECRET=your_adobe_client_secret_here
ADOBE_ORGANIZATION_ID=your_adobe_organization_id_here
ADOBE_ACCOUNT_ID=your_adobe_account_id_here
ADOBE_PRIVATE_KEY_FILE=private.key

# Apple Calendar (CalDAV) Configuration
CALDAV_URL=https://caldav.icloud.com/
CALDAV_USERNAME=your_apple_id_here
CALDAV_PASSWORD=your_app_specific_password_here

# Application Settings
LOG_LEVEL=INFO
CACHE_TTL=3600