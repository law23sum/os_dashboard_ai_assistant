# Local development
ENVIRONMENT=dev
LOG_LEVEL=DEBUG
SECRET_KEY=dev-secret-key

# Database
DATABASE_URL=postgresql://osdash:osdash@localhost:5432/osdash_dev
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OpenAI API
OPENAI_API_KEY=dev-openai-key
ASSISTANT_HUB_GPT5_PROMPT_SCAFFOLD=1
ASSISTANT_HUB_AGENTIC_EAGERNESS=medium

# Anthropic API (optional)
ANTHROPIC_API_KEY=

# Google APIs
GOOGLE_CLIENT_SECRET_PATH=./config/credentials/dev_client_secret.json
GOOGLE_APPLICATION_CREDENTIALS=./config/credentials/dev_service_account.json

# Microsoft Graph API
MS_GRAPH_CLIENT_ID=dev-client-id
MS_GRAPH_TENANT_ID=common
MS_GRAPH_CLIENT_SECRET=dev-client-secret

# Git Integration
GIT_USERNAME=dev-user
GIT_EMAIL=dev@example.com

# Security Settings
ENCRYPTION_KEY=dev-encryption-key
JWT_SECRET_KEY=dev-jwt-secret

# Optional: External Services
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Optional: Monitoring
SENTRY_DSN=
PROMETHEUS_PORT=9090

# GUI Settings (if running GUI)
DISPLAY=:0
