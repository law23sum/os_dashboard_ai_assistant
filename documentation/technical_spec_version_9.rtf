\cf2 19.3.3 Law-of-the-OS Constitutional Rule Examples\
\pard\pardeftab720\sa160\partightenfactor0
\cf0 Constitutional rules are global, hard-mode policies that encode Law-of-the-OS invariants. Example \'96 Non-Bypass of Governance law_id: "los.non_bypass_governance" scope: "global" effect: "deny" actions:\
- "*"\
conditions:\
policy_engine_available == false action_risk_level in ["medium", "high"] enforcement:\
mode: "hard" log_violation: true Example \'96 Explicit Approval for Irreversible Changes law_id: "los.irreversible_change" scope: "global" effect: "require_approval" actions:\
- "capsule.run"\
resources:\
irreversible_flag == true conditions:\
approvals.contains_role("Owner") == true approvals.contains_role("SecurityEngineer") == true Example \'96 No Unattributed Actions law_id: "los.no_unattributed_actions" scope: "global" effect: "deny" actions:\
- "*"\
conditions:\
subject.type not_in ["USER", "TENANT_DAEMON", "REGULATOR"] enforcement:\
mode: "hard"\
