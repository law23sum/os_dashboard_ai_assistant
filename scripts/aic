#!/usr/bin/env python3
"""
AIC Agent Command Script

Direct interface to AIC (Sir Chief Fellow Director Principal Software Solutions Systems Engineer Architect).
This is the execution/operational agent specializing in applied systems, integration, and implementation.

Usage:
    aic <message>              # Send message to AIC
    aic                        # Interactive chat with AIC
"""

import sys
import os
from pathlib import Path

# Add project root to path
project_root = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(project_root))

try:
    from agents_ai import AgentSystem
    import asyncio
except ImportError as e:
    error_msg = str(e)
    if "openai" in error_msg.lower() or "No module named 'openai'" in error_msg:
        print("❌ OpenAI package not installed.")
        print("\n📦 To install: pip install openai")
        print("💡 Then set your API key: export OPENAI_API_KEY='your-key-here'")
    elif "agents_ai" in error_msg:
        print(f"❌ Error importing agents_ai: {e}")
        print(f"Make sure agents_ai.py exists at: {project_root / 'agents_ai.py'}")
    else:
        print(f"❌ Error importing agents: {e}")
    sys.exit(1)


async def chat_with_aic(message: str = None):
    """Chat with AIC agent"""
    try:
        system = AgentSystem()
    except Exception as e:
        if "API key" in str(e) or "OPENAI_API_KEY" in str(e):
            print("❌ OpenAI API key not set.")
            print("💡 Set your API key: export OPENAI_API_KEY='your-key-here'")
        else:
            print(f"❌ Error initializing AIC: {e}")
        sys.exit(1)
    
    if "AIC" not in system.agents:
        print("❌ AIC agent not available.")
        sys.exit(1)
    
    aic = system.agents["AIC"]
    
    if message:
        # Single message mode
        print(f"\n🤖 AIC thinking...\n")
        try:
            response = await aic.think(message)
            print(f"\n[AIC]:\n{response}\n")
        except Exception as e:
            print(f"\n❌ Error: {e}")
            sys.exit(1)
    else:
        # Interactive mode
        print("\n" + "=" * 70)
        print("  AIC - Sir Chief Fellow Director Principal Software Solutions")
        print("        Systems Engineer Architect")
        print("=" * 70)
        print("\nYou are chatting with AIC, the execution and operational agent.")
        print("Type your message or '/quit' to exit.\n")
        
        while True:
            try:
                user_input = input("You > ").strip()
                
                if not user_input:
                    continue
                
                if user_input.lower() in ["/quit", "/exit", "quit", "exit"]:
                    print("Goodbye!")
                    break
                
                print(f"\n🤖 AIC thinking...\n")
                response = await aic.think(user_input)
                print(f"\n[AIC]:\n{response}\n")
                
            except KeyboardInterrupt:
                print("\nGoodbye!")
                break
            except Exception as e:
                print(f"❌ Error: {e}")
                print("Type '/quit' to exit or continue with another message.")


def main():
    """Main entry point"""
    message = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else None
    try:
        asyncio.run(chat_with_aic(message))
    except KeyboardInterrupt:
        print("\n\nInterrupted.")
    except Exception as e:
        print(f"\n❌ Error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
