# Local Development Environment Configuration
# OS Dashboard AI Assistant - Local/Dev Environment

# Environment
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=DEBUG

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///assistant_hub.db
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_RETENTION_DAYS=30

# Frontend
FRONTEND_URL=http://localhost:5173
FRONTEND_DEV_PORT=5173

# Security
SECRET_KEY=dev-secret-key-change-in-production
SESSION_TIMEOUT=3600
ENABLE_HTTPS=false

# Features
ENABLE_AUTO_BACKUP=true
ENABLE_TELEMETRY=false
ENABLE_ANALYTICS=false

# AI/ML Configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-4

# Testing
TEST_MODE=false
MOCK_EXTERNAL_APIS=false

# Logging
LOG_FORMAT=json
LOG_FILE=logs/local.log
LOG_ROTATION=daily

# Data Storage
DATA_DIR=./data
BACKUP_DIR=./data/backups
UPLOAD_DIR=./data/uploads
TEMP_DIR=./data/temp
