# Production Environment Configuration
# OS Dashboard AI Assistant - Production Environment

# Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=https://app.osdashboard.ai,https://www.osdashboard.ai

# Database
DATABASE_URL=postgresql://osdash_prod:${DB_PASSWORD}@db-primary.osdashboard.ai:5432/osdash_prod
DATABASE_REPLICA_URL=postgresql://osdash_prod:${DB_PASSWORD}@db-replica.osdashboard.ai:5432/osdash_prod
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_RETENTION_DAYS=90
DATABASE_POOL_SIZE=50
DATABASE_MAX_OVERFLOW=20
DATABASE_SSL_MODE=require

# Frontend
FRONTEND_URL=https://app.osdashboard.ai
CDN_URL=https://cdn.osdashboard.ai
STATIC_URL=https://static.osdashboard.ai

# Security
SECRET_KEY=${PRODUCTION_SECRET_KEY}
SESSION_TIMEOUT=3600
ENABLE_HTTPS=true
SSL_CERT_PATH=/etc/ssl/certs/production.crt
SSL_KEY_PATH=/etc/ssl/private/production.key
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# Features
ENABLE_AUTO_BACKUP=true
ENABLE_TELEMETRY=true
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true
ENABLE_MAINTENANCE_MODE=false

# AI/ML Configuration
OPENAI_API_KEY=${OPENAI_API_KEY}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-4-turbo
MODEL_FALLBACK=gpt-4
MAX_TOKENS=4096
REQUEST_TIMEOUT=120

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=100
RATE_LIMIT_REDIS_URL=redis://redis-cluster.osdashboard.ai:6379/1

# Caching
REDIS_URL=redis://redis-cluster.osdashboard.ai:6379/0
REDIS_SENTINEL_ENABLED=true
CACHE_TTL=7200
ENABLE_QUERY_CACHE=true
ENABLE_RESULT_CACHE=true

# Monitoring & Observability
SENTRY_DSN=${SENTRY_DSN}
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
ENABLE_APM=true
APM_SERVICE_NAME=osdash-production
DATADOG_API_KEY=${DATADOG_API_KEY}
DATADOG_SITE=datadoghq.com

# Testing
TEST_MODE=false
MOCK_EXTERNAL_APIS=false
ENABLE_FEATURE_FLAGS=true
FEATURE_FLAG_SERVICE=launchdarkly

# Logging
LOG_FORMAT=json
LOG_FILE=/var/log/osdash/production.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=90
LOG_AGGREGATION_ENDPOINT=${LOG_AGGREGATION_ENDPOINT}

# Data Storage
DATA_DIR=/var/osdash/data
BACKUP_DIR=/mnt/backups/osdash
UPLOAD_DIR=/mnt/uploads/osdash
TEMP_DIR=/tmp/osdash
S3_BUCKET=osdash-production
S3_REGION=us-east-1

# Performance
WORKER_PROCESSES=8
WORKER_CONNECTIONS=2000
KEEPALIVE_TIMEOUT=75
MAX_REQUESTS_PER_WORKER=10000
GRACEFUL_TIMEOUT=30

# Email
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM=noreply@osdashboard.ai
SMTP_TLS=true

# Queue & Workers
CELERY_BROKER_URL=redis://redis-cluster.osdashboard.ai:6379/2
CELERY_RESULT_BACKEND=redis://redis-cluster.osdashboard.ai:6379/3
CELERY_TASK_ALWAYS_EAGER=false

# Compliance & Audit
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years
GDPR_ENABLED=true
HIPAA_ENABLED=true
SOX_ENABLED=true

# Disaster Recovery
DR_ENABLED=true
DR_REGION=us-west-2
DR_RPO_HOURS=1
DR_RTO_HOURS=4
