# ==============================================================================
# OS Dashboard AI Assistant - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your API keys and credentials
# NEVER commit .env files to version control!
# See API_KEYS_GUIDE.md for links to obtain all API keys
# ==============================================================================

# ==============================================================================
# AI CHAT PROVIDERS
# ==============================================================================

# OpenAI (GPT-4, GPT-4 Turbo, GPT-3.5)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus)
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google AI (Gemini 2.0 Flash, Gemini 1.5 Pro)
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash-exp

# xAI (Grok)
# Get key: https://console.x.ai/api-keys
XAI_API_KEY=
XAI_MODEL=grok-beta

# Perplexity AI
# Get key: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Cohere
# Get key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# Mistral AI
# Get key: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Together AI (Open Source Models)
# Get key: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=
TOGETHER_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# Replicate (Open Source Models)
# Get key: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Hugging Face
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# DeepSeek
# Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Groq (Fast Inference)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# ==============================================================================
# CHATGPT SPECIFIC (FOR AGENTS)
# ==============================================================================

# ChatGPT API (Same as OpenAI but specifically for agent use)
CHATGPT_API_KEY=
CHATGPT_MODEL=gpt-4-turbo-preview

# ==============================================================================
# MICROSOFT SERVICES (Office 365, Azure)
# ==============================================================================

# Microsoft Graph API (Word, Excel, PowerPoint, Outlook, OneDrive)
# Setup: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/callback

# Azure OpenAI (Alternative to OpenAI)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ==============================================================================
# GOOGLE SERVICES (Gmail, Calendar, Drive, Workspace)
# ==============================================================================

# Google Workspace APIs
# Setup: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_REFRESH_TOKEN=

# ==============================================================================
# VERSION CONTROL & DEVELOPMENT
# ==============================================================================

# GitHub
# Get token: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_USERNAME=

# GitLab
# Get token: https://gitlab.com/-/profile/personal_access_tokens
GITLAB_TOKEN=
GITLAB_USERNAME=

# Bitbucket
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# ==============================================================================
# DOCUMENT PROCESSING
# ==============================================================================

# Adobe PDF Services
# Get credentials: https://developer.adobe.com/console
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_ORGANIZATION_ID=
ADOBE_ACCOUNT_ID=
ADOBE_PRIVATE_KEY_FILE=private.key

# ==============================================================================
# COLLABORATION & COMMUNICATION
# ==============================================================================

# Slack
# Create app: https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Discord
# Create app: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Notion
# Get integration: https://www.notion.so/my-integrations
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Trello
# Get key: https://trello.com/app-key
TRELLO_API_KEY=
TRELLO_TOKEN=

# Linear
# Get key: https://linear.app/settings/api
LINEAR_API_KEY=

# ==============================================================================
# APPLE SERVICES (macOS/iOS)
# ==============================================================================

# Apple Calendar (CalDAV)
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# Apple iCloud
ICLOUD_USERNAME=
ICLOUD_PASSWORD=

# ==============================================================================
# DATABASES & STORAGE
# ==============================================================================

# Database Configuration
DATABASE_URL=sqlite:///os_dashboard.db

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=os_dashboard
POSTGRES_USER=
POSTGRES_PASSWORD=

# MongoDB
MONGODB_URI=

# Redis
REDIS_URL=redis://localhost:6379

# Supabase
# Get keys: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=
SUPABASE_KEY=

# ==============================================================================
# VECTOR DATABASES (FOR AI/ML)
# ==============================================================================

# Pinecone
# Get key: https://app.pinecone.io/
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=

# Weaviate
WEAVIATE_URL=
WEAVIATE_API_KEY=

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ==============================================================================
# SEARCH & KNOWLEDGE
# ==============================================================================

# Brave Search API
# Get key: https://brave.com/search/api/
BRAVE_API_KEY=

# SerpAPI (Google Search)
# Get key: https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Wolfram Alpha
# Get app ID: https://developer.wolframalpha.com/portal/myapps/
WOLFRAM_APP_ID=

# ==============================================================================
# IMAGE & MEDIA AI
# ==============================================================================

# Stability AI (Stable Diffusion)
# Get key: https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# Eleven Labs (Voice AI)
# Get key: https://elevenlabs.io/app/settings/api-keys
ELEVEN_LABS_API_KEY=

# DALL-E (Uses OpenAI key above)
# Midjourney (No official API yet)

# ==============================================================================
# ANALYTICS & MONITORING
# ==============================================================================

# Datadog
DATADOG_API_KEY=
DATADOG_APP_KEY=

# New Relic
NEW_RELIC_API_KEY=
NEW_RELIC_LICENSE_KEY=

# Sentry (Error Tracking)
SENTRY_DSN=

# ==============================================================================
# SPREADSHEETS & DATA
# ==============================================================================

# Airtable
# Get key: https://airtable.com/account
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Google Sheets (Uses Google credentials above)

# ==============================================================================
# EMAIL SERVICES
# ==============================================================================

# SendGrid
SENDGRID_API_KEY=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# AWS SES
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_REGION=

# ==============================================================================
# CLOUD PROVIDERS
# ==============================================================================

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Google Cloud Platform
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

# Application
APP_NAME=OS Dashboard AI Assistant
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Cache
CACHE_TTL=3600

# Security
SECRET_KEY=
JWT_SECRET=
ENCRYPTION_KEY=

# ==============================================================================
# AGENT SYSTEM SETTINGS
# ==============================================================================

# Agent Display Settings (for GUI interaction)
DISPLAY=:0
AGENT_GUI_ENABLED=true
AGENT_SCREEN_CAPTURE=true

# Agent Collaboration
AGENT_COMMUNICATION_PORT=9000
AGENT_SHARED_MEMORY=true
AGENT_CODEBASE_ACCESS=true

# Agent Roles
AGENT_AIC_ENABLED=true
AGENT_ARIA_ENABLED=true
AGENT_SORA_ENABLED=true

# ==============================================================================
# CURSOR IDE SETTINGS
# ==============================================================================

# Cursor API (if available)
CURSOR_API_KEY=
CURSOR_MODEL=claude-3-5-sonnet-20241022

# ==============================================================================
# RATE LIMITING
# ==============================================================================

# API Rate Limits (requests per minute)
RATE_LIMIT_OPENAI=100
RATE_LIMIT_ANTHROPIC=50
RATE_LIMIT_GOOGLE=1000
RATE_LIMIT_XAI=50

# ==============================================================================
# ASSISTANT HUB SETTINGS
# ==============================================================================

# Data directories
ASSISTANT_HUB_HOME=~/.assistant_hub
ASSISTANT_HUB_DATA_DIR=~/.assistant_hub/data
ASSISTANT_HUB_DB=~/.assistant_hub/assistant_hub.db
ASSISTANT_HUB_ATTACHMENTS_DIR=~/.assistant_hub/attachments
ASSISTANT_HUB_INTEGRATIONS_DIR=~/.assistant_hub/integrations
ASSISTANT_HUB_FILE_CACHE_DIR=~/.assistant_hub/file_cache

# ==============================================================================
# DEVELOPMENT & TESTING
# ==============================================================================

# Testing
TEST_MODE=false
TEST_API_MOCK=false

# Debugging
DEBUG_MODE=false
VERBOSE_LOGGING=false

# ==============================================================================
# NOTES
# ==============================================================================
# 
# Quick Setup:
# 1. Copy this file: cp .env.example .env
# 2. Add your API keys (see API_KEYS_GUIDE.md for links)
# 3. Source the file: source .env (or restart your terminal)
# 4. Test with: python cursor_ai.py --check-keys
#
# Security:
# - Never commit .env to git (it's in .gitignore)
# - Use different keys for dev/staging/prod
# - Rotate keys every 90 days
# - Set up billing alerts on all services
#
# For more information, see API_KEYS_GUIDE.md
# ==============================================================================
