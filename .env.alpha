# Alpha/Beta Testing Environment Configuration
# OS Dashboard AI Assistant - Alpha/Beta Environment

# Environment
ENVIRONMENT=alpha
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=https://omniaxiom.com,https://omniaxiom.com

# Database
DATABASE_URL=postgresql://osdash_alpha:${DB_PASSWORD}@localhost/osdash_alpha
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_RETENTION_DAYS=60
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Frontend
FRONTEND_URL=https://alpha.osdashboard.ai
CDN_URL=https://cdn.osdashboard.ai

# Security
SECRET_KEY=${ALPHA_SECRET_KEY}
SESSION_TIMEOUT=7200
ENABLE_HTTPS=true
SSL_CERT_PATH=/etc/ssl/certs/alpha.crt
SSL_KEY_PATH=/etc/ssl/private/alpha.key

# Features
ENABLE_AUTO_BACKUP=true
ENABLE_TELEMETRY=true
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true

# AI/ML Configuration
OPENAI_API_KEY=${OPENAI_API_KEY}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-4
MODEL_FALLBACK=gpt-3.5-turbo

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=150

# Caching
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600
ENABLE_QUERY_CACHE=true

# Monitoring
SENTRY_DSN=${SENTRY_DSN}
ENABLE_APM=true
APM_SERVICE_NAME=osdash-alpha

# Testing
TEST_MODE=false
MOCK_EXTERNAL_APIS=false
ENABLE_FEATURE_FLAGS=true

# Logging
LOG_FORMAT=json
LOG_FILE=logs/alpha.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# Data Storage
DATA_DIR=/var/osdash/data
BACKUP_DIR=/var/osdash/backups
UPLOAD_DIR=/var/osdash/uploads
TEMP_DIR=/tmp/osdash

# Performance
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1000
KEEPALIVE_TIMEOUT=65

# Email (for notifications)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM=noreply@osdashboard.ai