        print("8) Save & Exit")
        print("-" * 70)

        choice = input("Choice: ").strip()

        if choice == "1":
            dashboard_view(state, settings)
        elif choice == "2":
            tasks_menu(conn, state)
        elif choice == "3":
            projects_menu(conn, state)
        elif choice == "4":
