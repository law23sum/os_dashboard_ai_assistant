# ================== EXTERNAL DATA MENU ==================

def external_data_menu(conn: sqlite3.Connection):
    while True:
        clear_screen()
        print_header("EXTERNAL DATA")

        c = conn.cursor()
        c.execute("""
            SELECT s.id, s.name, s.kind, s.connected, s.last_sync,
                   COUNT(e.id) as item_count
            FROM external_sources s
            LEFT JOIN external_items e ON e.source_id = s.id
            GROUP BY s.id, s.name, s.kind, s.connected, s.last_sync
            ORDER BY s.name
        """)
        rows = c.fetchall()

        if not rows:
            print("No external sources yet.")
            print("Once you integrate APIs, use record_external_item(...)")
            print("and data will show up here.")
            pause()
            return

        for r in rows:
            status = "connected" if r["connected"] else "disconnected"
            print(f"[{r['id']}] {r['name']} ({r['kind']}) – {status}, "
                  f"{r['item_count']} items, last_sync={r['last_sync']}")

        print("\nOptions:")
        print("1) View items for a source")
        print("2) Back")
        choice = input("Choice: ").strip()

        if choice == "1":
            try:
                sid_raw = input("Source ID: ").strip()
                sid = int(sid_raw)
            except ValueError:
                print("Invalid ID.")
                pause()
                continue

            c.execute("""
                SELECT id, external_id, kind, title, created_at, last_seen_at
                FROM external_items
                WHERE source_id = ?
                ORDER BY last_seen_at DESC
                LIMIT 50
            """, (sid,))
            items = c.fetchall()
            clear_screen()
            print_header(f"EXTERNAL ITEMS (source_id={sid})")
            if not items:
                print("No items for this source yet.")
            else:
                for it in items:
                    print(f"- [{it['id']}] {it['title']} ({it['kind']})")
                    print(f"    external_id: {it['external_id']}")
                    print(f"    created_at : {it['created_at']}")
                    print(f"    last_seen  : {it['last_seen_at']}")
                    print("-" * 70)
            pause()
        elif choice == "2":
            break
        else:
            print("Invalid choice.")
            pause()


