{
  "name": "os-dashboard-ai-assistant",
  "private": true,
  "version": "1.0.0",
  "description": "Root package to bridge npm workflows to the frontend workspace.",
  "scripts": {
    "build": "npm run --prefix frontend build",
    "dev": "npm run --prefix frontend dev",
    "dev:web": "npm run --prefix frontend dev:web",
    "dev:desktop": "npm run --prefix frontend dev:desktop",
    "export:ui-nav": "node scripts/export_ui_nav.js",
    "test:nav-export": "node --test nav_exports/__tests__/os_dashboard_gui_nav_routing_export.test.mjs",
    "test:nav-ia": "node --test nav_exports/__tests__/os_dashboard_gui_nav_required_ia.test.mjs",
    "validate:gui-nav": "node scripts/validate_gui_nav.js",
    "check:naming-drift": "node scripts/naming_drift_check.js",
    "test": "pytest && npm run test:nav-export && npm run test:nav-ia"
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.5.16",
    "@amplitude/plugin-session-replay-react-native": "^0.4.5",
    "@react-native-async-storage/async-storage": "^2.2.0"
  }
}
