# Beta Testing Environment
# =========================
# Used for beta testing with external testers
# Pre-production environment

VITE_ENVIRONMENT=beta
VITE_API_BASE_URL=${API_BASE_URL:-https://beta-api.osdashboard.ai/api}
VITE_APP_NAME=OS Dashboard AI Assistant (Beta)
VITE_APP_VERSION=1.0.0-beta

# Feature flags
VITE_ENABLE_DEBUG_LOGGING=true
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_ANALYTICS=true

# API timeouts (ms)
VITE_API_TIMEOUT=45000
VITE_API_RETRY_COUNT=2

# Testing
VITE_E2E_MODE=false
VITE_DEPLOY_ENV=beta
# Override in your beta deployment pipeline:
# VITE_API_BASE=https://beta.your-domain.tld