# Development Environment
# =======================
# Used for development server and local testing

VITE_ENVIRONMENT=development
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=OS Dashboard AI Assistant
VITE_APP_VERSION=1.0.0-dev

# Feature flags
VITE_ENABLE_DEBUG_LOGGING=true
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_ANALYTICS=false

# API timeouts (ms)
VITE_API_TIMEOUT=30000
VITE_API_RETRY_COUNT=3

# Testing
VITE_E2E_MODE=false
VITE_DEPLOY_ENV=local
# Backend base URL for local/dev. For desktop builds served by the backend at /app,
# leaving VITE_API_BASE unset will default to same-origin.
VITE_API_BASE=http://127.0.0.1:8000

VITE_API_TARGET=http://localhost:8000
VITE_ENV=development
# Development environment configuration
# This file sets defaults for local development

# API Server Configuration
# Port 8070 is used when running: python -m assistant_hub_gui.assistant_hub.core.api_server
# Port 8000 is used when running: python start_ui.py --mode web
VITE_API_TARGET=http://localhost:8070

# To use the start_ui.py server instead (port 8000), uncomment:
# VITE_API_TARGET=http://localhost:8000