# Development environment configuration
# This file sets defaults for local development

# API Server Configuration
# Port 8070 is used when running: python -m assistant_hub_gui.assistant_hub.core.api_server
# Port 8000 is used when running: python start_ui.py --mode web
VITE_API_TARGET=http://localhost:8070

# To use the start_ui.py server instead (port 8000), uncomment:
# VITE_API_TARGET=http://localhost:8000
