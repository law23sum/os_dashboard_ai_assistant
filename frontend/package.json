{
  "name": "os-dashboard-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Unified Tkinter-inspired React + Electron interface for the OS Dashboard AI Assistant.",
  "author": "OS Dashboard Engineering",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "sync-docs": "node ./scripts/sync-docs.js",
    "predev:web": "npm run sync-docs",
    "predev:web-only": "npm run sync-docs",
    "prebuild": "npm run sync-docs",
    "prebuild:web": "npm run sync-docs",
    "prebuild:desktop": "npm run sync-docs",
    "prebuild:desktop:linux": "npm run sync-docs",
    "prebuild:desktop:windows": "npm run sync-docs",
    "prebuild:desktop:mac": "npm run sync-docs",
    "prepreview": "npm run sync-docs",
    "dev": "node ./scripts/dev.js",
    "dev:web": "vite",
    "dev:web-only": "vite",
    "dev:web:alpha": "vite --mode alpha",
    "dev:web:beta": "vite --mode beta",
    "dev:web:network": "vite --host",
    "dev:web-only:network": "vite --host",
    "electron:dev": "wait-on http://localhost:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev:desktop": "node ./scripts/dev-desktop.js",
    "build": "vite build",
    "build:web": "vite build",
    "build:alpha": "vite build --mode alpha",
    "build:beta": "vite build --mode beta",
    "build:desktop": "vite build && electron-builder -c electron-builder.yml",
    "build:desktop:linux": "vite build && electron-builder -c electron-builder.yml --linux",
    "build:desktop:windows": "vite build && electron-builder -c electron-builder.yml --win",
    "build:desktop:mac": "vite build && electron-builder -c electron-builder.yml --mac",
    "build:all": "npm run build:web && npm run build:desktop:linux && npm run build:desktop:windows && npm run build:desktop:mac",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:desktop": "node --test electron/__tests__/*.test.cjs",
    "test:e2e": "cross-env E2E_BASE_URL=http://127.0.0.1:5173 E2E_USE_WEB_SERVER=1 playwright test",
    "test:e2e:stack": "cross-env E2E_BASE_URL=http://127.0.0.1:5173 E2E_USE_WEB_SERVER=0 concurrently -k -s first -n backend,frontend,tests \"python -m uvicorn backend_api.main:app --app-dir .. --host 127.0.0.1 --port 8000\" \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 http://127.0.0.1:8000/api/health && playwright test\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.27.5",
    "axios": "^1.20.0",
    "lucide-react": "^0.365.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.3",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^39.8.5",
    "electron-builder": "^24.9.1",
    "jsdom": "^23.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^7.3.2",
    "vitest": "^4.0.16",
    "wait-on": "^7.2.0"
  }
}
