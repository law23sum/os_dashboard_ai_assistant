# Alpha Testing Environment
# ==========================
# Used for alpha testing with internal testers
# Integrated testing environment

VITE_ENVIRONMENT=alpha
VITE_API_BASE_URL=${API_BASE_URL:-https://alpha-api.osdashboard.ai/api}
VITE_APP_NAME=OS Dashboard AI Assistant (Alpha)
VITE_APP_VERSION=1.0.0-alpha

# Feature flags
VITE_ENABLE_DEBUG_LOGGING=true
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_ANALYTICS=true

# API timeouts (ms)
VITE_API_TIMEOUT=45000
VITE_API_RETRY_COUNT=2

# Testing
VITE_E2E_MODE=false
VITE_DEPLOY_ENV=alpha
# Override in your alpha deployment pipeline:
# VITE_API_BASE=https://alpha.your-domain.tld